# --- Приложение ---
APP_NAME=ClickRent
ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false

# --- База данных ---
# Для запуска на хосте (uvicorn, pytest) — localhost.
# В docker compose DATABASE_URL переопределяется и указывает на сервис db.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clickrent

# --- Redis ---
# Pub/Sub для WebSocket, присутствие зрителей, кэш, rate limiting, распределенный лок фоновых задач.
# В docker compose REDIS_URL переопределяется и указывает на сервис redis.
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Сгенерируйте ключ: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Бронирования ---
# Сколько минут pending-бронь удерживает даты до подтверждения владельцем
BOOKING_PENDING_TTL_MINUTES=30
# Период фоновой задачи: снятие истекших броней и завершение прошедших проживаний
BOOKING_TASKS_INTERVAL_SECONDS=60

# --- Rate limiting ---
# Лимиты запросов с одного IP: "<количество>/<second|minute|hour|day>" или "<количество>/<секунды>"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute

# --- Docker compose ---
POSTGRES_DB=clickrent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
HTTP_PORT=80
# Количество воркеров Gunicorn; WebSocket-состояние общее для всех воркеров через Redis
WEB_CONCURRENCY=2
